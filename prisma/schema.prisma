generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FavoriteCategory {
  AGENT
  MAP
  WEAPON
  SKIN
}

enum VoteAction {
  CREATED
  CHANGED
}

model CommunityVote {
  id         String           @id @default(cuid())
  deviceHash String
  category   FavoriteCategory
  scopeKey   String           @default("default")
  targetId   String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([deviceHash, category, scopeKey])
  @@index([category, scopeKey, targetId])
  @@map("community_votes")
}

model VoteEvent {
  id          BigInt           @id @default(autoincrement())
  deviceHash  String
  networkHash String
  category    FavoriteCategory
  scopeKey    String
  targetId    String
  action      VoteAction
  createdAt   DateTime         @default(now())

  @@index([deviceHash, createdAt])
  @@index([networkHash, createdAt])
  @@index([category, scopeKey, createdAt])
  @@index([createdAt])
  @@map("community_vote_events")
}
