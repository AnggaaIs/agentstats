generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FavoriteCategory {
  AGENT
  MAP
  WEAPON
  SKIN
}

enum VoteAction {
  CREATED
  CHANGED
}

enum ProfileVisibility {
  PRIVATE
  PUBLIC
}

enum MatchResult {
  WIN
  LOSS
  DRAW
}

enum ObservationScope {
  SELF
  MATCH_CONTEXT
}

enum ImprovementMetric {
  OPENING_CONVERSION
  SURVIVAL_RATE
  KAST
  PISTOL_WIN_RATE
  ECONOMY_DAMAGE
  CONSISTENCY
}

enum ImprovementPlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TeamRole {
  OWNER
  MEMBER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  puuid             String?           @unique
  gameName          String?
  tagLine           String?
  region            String            @default("ap")
  visibility        ProfileVisibility @default(PRIVATE)
  consentVersion    String?
  consentedAt       DateTime?
  publishedAt       DateTime?
  revokedAt         DateTime?
  lastProfileSyncAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  accounts               Account[]
  sessions               Session[]
  agentMatchObservations AgentMatchObservation[]
  legalConsents          LegalConsent[]
  improvementPlans       ImprovementPlan[]
  matchJournals          MatchJournal[]
  shareReports           ShareReport[]
  ownedTeams             Team[]                  @relation("TeamOwner")
  teamMemberships        TeamMember[]

  @@index([gameName, tagLine])
  @@index([visibility, publishedAt])
  @@map("users")
}

model LegalConsent {
  id             String    @id @default(cuid())
  token          String    @unique
  userId         String?
  consentVersion String
  acceptedAt     DateTime  @default(now())
  linkedAt       DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, acceptedAt])
  @@index([consentVersion, acceptedAt])
  @@map("legal_consents")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model CommunityVote {
  id         String           @id @default(cuid())
  deviceHash String
  category   FavoriteCategory
  scopeKey   String           @default("default")
  targetId   String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([deviceHash, category, scopeKey])
  @@index([category, scopeKey, targetId])
  @@map("community_votes")
}

model VoteEvent {
  id          BigInt           @id @default(autoincrement())
  deviceHash  String
  networkHash String
  category    FavoriteCategory
  scopeKey    String
  targetId    String
  action      VoteAction
  createdAt   DateTime         @default(now())

  @@index([deviceHash, createdAt])
  @@index([networkHash, createdAt])
  @@index([category, scopeKey, createdAt])
  @@index([createdAt])
  @@map("community_vote_events")
}

model AgentMatchObservation {
  id              String      @id @default(cuid())
  sourceUserId    String
  matchId         String
  participantHash String
  scope           ObservationScope @default(SELF)
  region          String
  actId           String?
  queueId         String
  mapId           String
  agentId         String
  competitiveTier Int?
  teamId          String
  result          MatchResult
  matchStartedAt  DateTime
  observedAt      DateTime    @default(now())
  roundsPlayed    Int
  roundsWon       Int
  roundsLost      Int
  score           Int
  kills           Int
  deaths          Int
  assists         Int
  damage          Int
  damageReceived  Int
  headshots       Int
  bodyshots       Int
  legshots        Int
  kastRounds      Int
  firstBloods     Int
  plants          Int
  defuses         Int
  playtimeMillis  Int

  sourceUser User @relation(fields: [sourceUserId], references: [id], onDelete: Cascade)

  @@unique([matchId, participantHash])
  @@index([sourceUserId, matchStartedAt])
  @@index([scope, actId, queueId])
  @@index([actId, queueId, region])
  @@index([agentId, actId])
  @@index([matchStartedAt])
  @@map("agent_match_observations")
}

model ImprovementPlan {
  id            String                @id @default(cuid())
  userId        String
  metric        ImprovementMetric
  baselineValue Float
  targetValue   Float
  durationDays  Int
  status        ImprovementPlanStatus @default(ACTIVE)
  startsAt      DateTime              @default(now())
  endsAt        DateTime
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("improvement_plans")
}

model MatchJournal {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  focus     String
  mood      Int
  stackSize Int
  note      String
  vodUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId, updatedAt])
  @@map("match_journals")
}

model ShareReport {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  title      String
  anonymized Boolean  @default(true)
  snapshot   Json
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([token, revokedAt])
  @@map("share_reports")
}

model Team {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  joinCode  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members TeamMember[]

  @@index([ownerId, createdAt])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId, joinedAt])
  @@map("team_members")
}
