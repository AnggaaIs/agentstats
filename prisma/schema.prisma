generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FavoriteCategory {
  AGENT
  MAP
  WEAPON
  SKIN
}

enum VoteAction {
  CREATED
  CHANGED
}

enum ProfileVisibility {
  PRIVATE
  PUBLIC
}

enum MatchResult {
  WIN
  LOSS
  DRAW
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  puuid             String?           @unique
  gameName          String?
  tagLine           String?
  region            String            @default("ap")
  visibility        ProfileVisibility @default(PRIVATE)
  consentVersion    String?
  consentedAt       DateTime?
  publishedAt       DateTime?
  revokedAt         DateTime?
  lastProfileSyncAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  accounts Account[]
  sessions Session[]
  agentMatchObservations AgentMatchObservation[]
  legalConsents LegalConsent[]

  @@index([gameName, tagLine])
  @@index([visibility, publishedAt])
  @@map("users")
}

model LegalConsent {
  id             String   @id @default(cuid())
  token          String   @unique
  userId         String?
  consentVersion String
  acceptedAt     DateTime @default(now())
  linkedAt       DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, acceptedAt])
  @@index([consentVersion, acceptedAt])
  @@map("legal_consents")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model CommunityVote {
  id         String           @id @default(cuid())
  deviceHash String
  category   FavoriteCategory
  scopeKey   String           @default("default")
  targetId   String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([deviceHash, category, scopeKey])
  @@index([category, scopeKey, targetId])
  @@map("community_votes")
}

model VoteEvent {
  id          BigInt           @id @default(autoincrement())
  deviceHash  String
  networkHash String
  category    FavoriteCategory
  scopeKey    String
  targetId    String
  action      VoteAction
  createdAt   DateTime         @default(now())

  @@index([deviceHash, createdAt])
  @@index([networkHash, createdAt])
  @@index([category, scopeKey, createdAt])
  @@index([createdAt])
  @@map("community_vote_events")
}

model AgentMatchObservation {
  id              String      @id @default(cuid())
  sourceUserId    String
  matchId         String
  participantHash String
  region          String
  actId           String?
  queueId         String
  mapId           String
  agentId         String
  competitiveTier Int?
  teamId          String
  result          MatchResult
  matchStartedAt  DateTime
  observedAt      DateTime    @default(now())
  roundsPlayed    Int
  roundsWon       Int
  roundsLost      Int
  score           Int
  kills           Int
  deaths          Int
  assists         Int
  damage          Int
  damageReceived  Int
  headshots       Int
  bodyshots       Int
  legshots        Int
  kastRounds      Int
  firstBloods     Int
  plants          Int
  defuses         Int
  playtimeMillis  Int

  sourceUser User @relation(fields: [sourceUserId], references: [id], onDelete: Cascade)

  @@unique([matchId, participantHash])
  @@index([sourceUserId, matchStartedAt])
  @@index([actId, queueId, region])
  @@index([agentId, actId])
  @@index([matchStartedAt])
  @@map("agent_match_observations")
}
